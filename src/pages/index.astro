---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const publisherParam = Astro.url.searchParams.get('publisher');
const parsedPublisherId = publisherParam ? Number(publisherParam) : undefined;
const selectedPublisherId = parsedPublisherId !== undefined && Number.isInteger(parsedPublisherId)
  ? parsedPublisherId
  : undefined;
const [games, publisherList] = await Promise.all([
  getAllGames(database, selectedPublisherId),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form method="get" class="flex items-center gap-3">
          <label for="publisher" class="text-sm font-medium text-slate-300">Publisher</label>
          <select
            id="publisher"
            name="publisher"
            data-testid="publisher-filter"
            class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="" selected={selectedPublisherId === undefined}>All publishers</option>
            {publisherList.map((publisher) => (
              <option value={publisher.id} selected={selectedPublisherId === publisher.id}>
                {publisher.name}
              </option>
            ))}
          </select>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <p class="hidden text-slate-300" data-testid="publisher-filter-empty">No games found for this publisher.</p>
    </div>
  </div>
</Layout>

<script>
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-testid="publisher-filter-empty"]');

  function applyPublisherFilter(publisherId: string): void {
    let visibleGames = 0;

    for (const card of gameCards) {
      const isVisible = publisherId === '' || card.dataset.gamePublisherId === publisherId;
      card.hidden = !isVisible;
      visibleGames += isVisible ? 1 : 0;
    }

    gamesGrid?.classList.toggle('hidden', visibleGames === 0);
    emptyMessage?.classList.toggle('hidden', visibleGames !== 0);
  }

  publisherFilter?.addEventListener('change', () => {
    const url = new URL(window.location.href);
    if (publisherFilter.value === '') {
      url.searchParams.delete('publisher');
    } else {
      url.searchParams.set('publisher', publisherFilter.value);
    }
    window.history.replaceState({}, '', url);
    applyPublisherFilter(publisherFilter.value);
  });

  applyPublisherFilter(publisherFilter?.value ?? '');
</script>
